{
  "sourceLanguage" : "en",
  "strings" : {
    "reel.bonusCaption" : {
      "comment" : "Caption above the bonus points awarded by the reels",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "REEL BONUS" } }
      }
    },
    "reel.bonusValue" : {
      "comment" : "Bonus points added by the reels, e.g. +150",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "+%lld" } }
      }
    },
    "reel.shortfall" : {
      "comment" : "How much more is needed on one reel, shown in the game HUD, e.g. +13",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "+%lld" } }
      }
    },
    "reel.shortfallMet" : {
      "comment" : "Shown under a reel that already reached the next tier",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "✓" } }
      }
    },
    "reel.hudSlotLabel" : {
      "comment" : "VoiceOver label for one in-round reel. 1: dimension, 2: value, 3: symbol, 4: how much more is needed",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ %2$lld, %3$@, %4$lld to go" } }
      }
    },
    "reel.hudSlotLabelMet" : {
      "comment" : "VoiceOver label for an in-round reel that already reached the next tier. 1: dimension, 2: value, 3: symbol",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ %2$lld, %3$@, reached" } }
      }
    },
    "reel.floorCaption" : {
      "comment" : "Shown when the reels differ but still pay. Placeholder is the lowest symbol's name, e.g. Bell",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ BONUS" } }
      }
    },
    "reel.dimension.combo" : {
