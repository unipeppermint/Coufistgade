{
  "sourceLanguage": "en",
  "strings": {
    "%lld seconds remaining": {
      "comment": "VoiceOver label for the round timer",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld seconds remaining"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余 %lld 秒"
          }
        }
      }
    },
    "Also follows the system setting in Accessibility.": {
      "comment": "Footer under the Reduce Motion row",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also follows the system setting in Accessibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时遵循系统「辅助功能」中的设置。"
          }
        }
      }
    },
    "BEST": {
      "comment": "Caption above the best score on Home",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BEST"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最高分"
          }
        }
      }
    },
